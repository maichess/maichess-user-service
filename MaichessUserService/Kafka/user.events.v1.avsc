{
  "type": "record",
  "name": "UserEvent",
  "namespace": "maichess.events.user",
  "doc": "Value schema for the user.events.v1 topic (compacted). Profile and rating facts emitted for downstream consumers.",
  "fields": [
    { "name": "event_id", "type": "string" },
    { "name": "event_type", "type": "string" },
    { "name": "aggregate_id", "type": "string", "doc": "userId" },
    { "name": "sequence", "type": "long", "default": 0 },
    { "name": "occurred_at", "type": "long" },
    { "name": "correlation_id", "type": "string", "default": "" },
    { "name": "causation_id", "type": "string", "default": "" },
    { "name": "producer", "type": "string" },
    {
      "name": "payload",
      "type": [
        {
          "type": "record",
          "name": "UserRegistered",
          "fields": [
            { "name": "user_id", "type": "string" },
            { "name": "username", "type": "string" }
          ]
        },
        {
          "type": "record",
          "name": "ProfileUpdated",
          "fields": [
            { "name": "user_id", "type": "string" },
            { "name": "username", "type": "string" },
            { "name": "dev_mode", "type": "boolean" }
          ]
        },
        {
          "type": "record",
          "name": "MatchResultRecorded",
          "doc": "Emitted by Match Manager on match end; consumed by User to update Glicko-2 rating.",
          "fields": [
            { "name": "user_id", "type": "string" },
            {
              "name": "outcome",
              "type": { "type": "enum", "name": "MatchOutcome", "symbols": ["WIN", "LOSS", "DRAW"], "default": "DRAW" }
            },
            { "name": "opponent_rating", "type": "double" },
            { "name": "opponent_rd", "type": "double" }
          ]
        },
        {
          "type": "record",
          "name": "RatingUpdated",
          "fields": [
            { "name": "user_id", "type": "string" },
            { "name": "rating", "type": "double" },
            { "name": "rating_deviation", "type": "double" },
            { "name": "volatility", "type": "double" },
            { "name": "elo", "type": "int" }
          ]
        }
      ]
    }
  ]
}
